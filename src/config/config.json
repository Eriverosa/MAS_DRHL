{
  "experiments": [
    { "travelModel": "HAVERSINE",   "enabled": true, "nTest": 7 },
    { "travelModel": "GRAPH_HOPPER", "enabled": true, "nTest": 7 }
  ],
  "graphHopper": { "baseUrl": "http://localhost:8989/route", "profile": "car", "useStandardSpeed": true },
  "simulation": { "amountByPersonCc": 2500, "delayByPersonMinutes": 1, "executionInitMinutes": 0, "executionAddMinutes": 5 },
  "speeds": { "unit": "KILOMETRE_PER_HOUR", "loadedSpeed": 30.0, "noLoadedSpeed": 50.0, "standardSpeed": 50.0 },
  "stockThresholds": { "distributionMinStockPercent": 0.75, "donorMinStockPercent": 0.20 },
  "weights": { "requiredSupplyPersonasPercent": 1, "requiredSupplyDistancePercent": 0, "proposedAmountHelpPercent": 1, "proposedDistancePercent": 0, "transportationStartTimePercent": 1, "transportationEndTimePercent": 0, "transportationQuantityTransportedPercent": 0 },
  "materialStockSizes": [20000, 2250, 2000, 1600, 1000, 500],
  "materialStockSizesHeaderCSV": "StockBotellas_{size}_cc",
  "agents": {
    "administrator":    { "className": "Administrator",    "dataFile": null },
    "transporter":      { "className": "Transporter",      "dataFile": "./src/dataFiles/ArchivoAgente_Transporte.csv" },
    "truck":            { "className": "Truck",            "dataFile": "./src/dataFiles/ArchivoAgente_Transporte.csv" },
    "donor":            { "className": "Donor",            "dataFile": "./src/dataFiles/ArchivoAgente_Donador.csv" },
    "distributionArea": { "className": "DistributionArea", "dataFile": "./src/dataFiles/ArchivoAgente_PuntoDistribucion.csv" },
    "collectionPlace":  { "className": "CollectionPlace",  "dataFile": "./src/dataFiles/ArchivoAgente_LugarAcopio.csv" }
  },
  "scenarios": [
    { "name": "POST-PRINCIPAL-TERREMOTO",  "iterations": 100, "enabledAgents": { "transporter": 8,  "truck": 90, "donor": 8,  "distributionArea": 10, "collectionPlace": 1 } } 
  ]
}